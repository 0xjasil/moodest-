{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/main.ts",
    "src/app.module.ts",
    "src/config/**/*",
    "src/common/**/*",
    "src/database/**/*",
    "src/modules/**/*",
    "src/inventory/**/*",
    "src/orders/**/*",
    "src/payments/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/app",
    "src/server",
    "src/lib",
    "src/schema",
    "src/middleware.ts"
  ]
}
