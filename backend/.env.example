# ==============================================================================
# MOODEST BACKEND — Environment Configuration Example
# Single-Brand Abaya E-Commerce (NestJS + Prisma + PostgreSQL)
# ==============================================================================

# App
PORT=4000
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Neon PostgreSQL Connection Strings
DATABASE_URL="postgresql://user:password@ep-pooler.region.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@ep-direct.region.neon.tech/neondb?sslmode=require"

# JWT
JWT_SECRET="replace-with-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Admin Seed Credentials (Required for npm run db:seed — No default fallbacks)
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="replace-with-secure-admin-password"
SEED_ADMIN_NAME="Moodest Store Admin"
# Set SEED_ADMIN_RESET_PASSWORD=true to overwrite/rotate an existing admin password hash.
# Default is false: creates the admin if missing, and preserves existing hash without overwriting.
SEED_ADMIN_RESET_PASSWORD="false"

# Razorpay
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-test-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-webhook-secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Redis
REDIS_URL="rediss://default:password@host:6379"
UPSTASH_REDIS_REST_URL="https://your-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="Moodest <no-reply@yourdomain.com>"
ADMIN_EMAIL="owner@yourdomain.com"

# Test Database Isolation & Safety
# Set TEST_DATABASE_URL to isolate tests to a dedicated Neon branch (e.g., "test").
# Mandatory when running in test mode (NODE_ENV=test).
# TEST_DATABASE_URL="postgresql://user:password@ep-test-branch-pooler.region.neon.tech/neondb?sslmode=require"
# TEST_DIRECT_DATABASE_URL="postgresql://user:password@ep-test-branch-direct.region.neon.tech/neondb?sslmode=require"
ALLOW_TESTS_ON_MAIN_DB="false"
