# NestJS server origin. Do not include a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000

# The API's global NestJS prefix. Set to an empty value only if it has none.
NEXT_PUBLIC_API_PREFIX=/api

# Future Razorpay Integration (Currently Disabled)
NEXT_PUBLIC_RAZORPAY_ENABLED=false
NEXT_PUBLIC_RAZORPAY_KEY_ID=
